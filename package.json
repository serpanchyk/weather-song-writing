{
  "name": "weather-song-writing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors cyan,green \"npm run dev --workspace @weather-song-writing/web\" \"npm run dev --workspace @weather-song-writing/api\"",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}
